{
  "mcpServers": {
    "augment": {
      "type": "stdio",
      "command": "auggie",
      "args": [
        "--mcp",
        "--mcp-auto-workspace"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "better-context": {
      "type": "http",
      "url": "https://btca.dev/api/mcp",
      "enabled": true,
      "timeout": 120000,
      "headers": {
        "Authorization": "Bearer ${BTCA_API_KEY}"
      }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "grafana": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_USERNAME": "${GRAFANA_USERNAME:-admin}",
        "GRAFANA_PASSWORD": "${GRAFANA_PASSWORD}"
      },
      "enabled": true,
      "timeout": 120000
    },
    "ref": {
      "type": "http",
      "url": "https://api.ref.tools/mcp?apiKey=${REF_API_KEY}",
      "enabled": true,
      "timeout": 120000
    }
  }
}
